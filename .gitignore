# =========================
# Node.js
# =========================

# Ignore node_modules at any depth
**/node_modules/

# npm/yarn/pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Build / Output
# =========================

# Ignore build folders anywhere
**/build/
**/dist/
**/out/

# Common framework outputs
**/.next/
**/.nuxt/
**/.svelte-kit/
**/.parcel-cache/

# =========================
# Python
# =========================

__pycache__/
**/__pycache__/

*.pyc
*.pyo
*.pyd

.venv/
**/.venv/
venv/
env/
ENV/

# =========================
# ScriptEngine data
# =========================

# Per-series corpora, stores and indexes: large, machine-generated, and fully
# regenerable from the MediaWiki API. The manifest is excluded too — it carries
# every title on the wiki, so it churns on each crawl.
#
# `overrides.yaml` is the exception. It is hand-written, it is the only place a
# wiki-specific rule may live, and losing it means rediscovering that rule.
series/*
!series/*/
series/*/*
!series/*/overrides.yaml

# Model caches
.cache/
hf_cache/

# =========================
# IDEs
# =========================

.vscode/
**/.vscode/

.idea/
**/.idea/

# =========================
# Environment Files
# =========================

.env
.env.*
!.env.example

# =========================
# OS Files
# =========================

.DS_Store
Thumbs.db
desktop.ini

# =========================
# Temporary Files
# =========================

*.tmp
*.temp
*.cache

# =========================
# Coverage / Testing
# =========================

coverage/
**/coverage/

.pytest_cache/
.mypy_cache/

# =========================
# Runtime Data
# =========================

logs/
**/logs/

*.log