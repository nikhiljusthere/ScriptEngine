# =========================
# Node.js
# =========================

# Ignore node_modules at any depth
**/node_modules/

# npm/yarn/pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Build / Output
# =========================

# Ignore build folders anywhere
**/build/
**/dist/
**/out/

# Common framework outputs
**/.next/
**/.nuxt/
**/.svelte-kit/
**/.parcel-cache/

# =========================
# Python
# =========================

__pycache__/
**/__pycache__/

*.pyc
*.pyo
*.pyd

.venv/
**/.venv/
venv/
env/
ENV/

# =========================
# ScriptEngine data
# =========================

# Per-series corpora, stores and indexes: large, machine-generated, and fully
# regenerable from the MediaWiki API. The manifest is excluded too; it carries
# every title on the wiki, so it churns on each crawl.
#
# `overrides.yaml` is the exception. It is hand-written, it is the only place a
# wiki-specific rule may live, and losing it means rediscovering that rule.
series/*
!series/*/
series/*/*
!series/*/overrides.yaml

# Model caches
.cache/
hf_cache/

# =========================
# graphify
# =========================

# GRAPH_REPORT.md and graph.json are committed: the report is how a new session
# orients itself, and the graph is what answers questions about this codebase.
# Everything else is a rebuildable artefact or an extraction cache.
graphify-out/graph.html
graphify-out/cache/
graphify-out/.graphify_chunk_*.json
graphify-out/obsidian/
graphify-out/graph.svg
graphify-out/graph.graphml
graphify-out/cypher.txt
.graphify_*

# =========================
# IDEs
# =========================

.vscode/
**/.vscode/

.idea/
**/.idea/

# =========================
# Environment Files
# =========================

.env
.env.*
!.env.example

# =========================
# OS Files
# =========================

.DS_Store
Thumbs.db
desktop.ini

# =========================
# Temporary Files
# =========================

*.tmp
*.temp
*.cache

# =========================
# Coverage / Testing
# =========================

coverage/
**/coverage/

.pytest_cache/
.mypy_cache/

# =========================
# Runtime Data
# =========================

logs/
**/logs/

*.log
# =========================
# ScriptEngine working output
# =========================

# Fetched research context: regenerable from the index in one command, and
# nearly 100 KB of wiki prose per fetch. Finished scripts are filed into the
# production tree (SCRIPTENGINE_SCRIPTS_ROOT), not here.
scripts output/

# =========================
# Measurement runs
# =========================

# Only the raw dump. `reports/` and `questions/` are deliberately tracked:
# a run's whole value is comparison against the last one, the artefacts are
# small, and the answer sheet this pipeline replaces was lost precisely
# because it lived in a gitignored folder. `answers.md` is the exception --
# every returned member of every question, regenerable, and long enough to
# bury the report beside it.
#
# Nothing here may be named `out`: `**/out/` above would swallow it silently.
reports/*/answers.md

