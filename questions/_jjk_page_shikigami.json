    {
      "id": "jjk-pg-shikigami-032",
      "kind": "fact",
      "question": "For what purpose were winged insect-like shikigami known as Kogane created?",
      "subject": "Shikigami",
      "tier": "wiki",
      "expect_mode": "qa",
      "answer": [
        {
          "item": "To facilitate the Culling Game, winged insect-like shikigami known as Kogane were created to act as the game's interface.",
          "aliases": []
        }
