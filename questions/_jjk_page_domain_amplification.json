      "id": "jjk-pg-domain_amplification-027",
      "kind": "fact",
      "question": "What does Domain Amplification do?",
      "subject": "Domain Amplification",
      "tier": "wiki",
      "expect_mode": "qa",
      "answer": [
        {
          "item": "The user wraps themselves thinly in a domain unimbued with a cursed technique, allowing them to pour an opponent's technique into the empty space and negate it on contact.",
          "aliases": []
        }
      ],
      "sources": [
        "https://jujutsu-kaisen.fandom.com/wiki/Domain_Amplification"
      ],
      "verified": "2026-09-03",
      "note": "prose: Description"
    },
