    {
      "id": "jjk-pg-domain_amplification-029",
      "kind": "fact",
      "question": "What is the primary drawback of Domain Amplification?",
      "subject": "Domain Amplification",
      "tier": "wiki",
      "expect_mode": "qa",
      "answer": [
        {
          "item": "Amplification's primary drawback is that an innate technique cannot be activated at the same time, limiting the user to relying on hand-to-hand combat.",
          "aliases": []
        }
      ],
      "sources": [
        "https://jujutsu-kaisen.fandom.com/wiki/Domain_Amplification"
